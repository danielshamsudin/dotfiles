/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    font:   "JetBrainsMono Nerd Font 12";

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       center;
    width:          650;
    border-radius:  20px;
    border:         2px;
    border-color:   @bg3;

    background-color:   @bg0;
}

mainbox {
    padding:    16px;
}

inputbar {
    background-color:   @bg1;
    border-color:       @bg3;

    border:         2px;
    border-radius:  12px;

    padding:    12px 16px;
    spacing:    10px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @bg3;
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @fg3;
    text-color:         @fg0;
}

message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       @bg2;
    background-color:   @bg2;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   transparent;

    margin:     16px 0 0;
    lines:      8;
    columns:    1;
    spacing:    4px;

    fixed-height: false;
}

element {
    padding:        10px 16px;
    spacing:        10px;
    border-radius:  10px;
    background-color: transparent;
}

element normal normal {
    text-color: @fg0;
}

element normal active {
    text-color: @bg3;
}

element alternate normal {
    text-color: @fg0;
}

element alternate active {
    text-color: @bg3;
}

element selected normal {
    background-color:   @bg3;
    text-color:         @bg0;
    font:               "JetBrainsMono Nerd Font Bold 12";
}

element selected active {
    background-color:   @bg3;
    text-color:         @bg0;
    font:               "JetBrainsMono Nerd Font Bold 12";
}

element-icon {
    size:           1.2em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}
